<UserControl x:Class="LMCL.App.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="LogItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="Transparent" Padding="12,1.5">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource LayerBrush}"
          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="14,9,8,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="13.5"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="复制全部" Style="{StaticResource SubtleButton}"
                  Padding="9,3" FontSize="12" Click="Copy_Click" />
          <Button Content="清空" Style="{StaticResource SubtleButton}"
                  Padding="9,3" FontSize="12" Click="Clear_Click" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" />

      <ListBox Grid.Row="2" x:Name="List" Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource LogItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" FontSize="11.5" Margin="0,0,9,0"
                         VerticalAlignment="Top"
                         Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                         TextWrapping="Wrap" Foreground="{Binding Brush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyHint" Text="还没有日志" Style="{StaticResource CaptionText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" />
    </Grid>
  </Border>
</UserControl>
