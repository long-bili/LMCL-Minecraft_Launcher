<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    暗色主题。数值取自 WinUI 3 的 Fluent 令牌（Dark 主题）。
    键名与亮色主题完全一致，靠运行时换字典来切肤。

    注意两处和亮色不同、容易写错的：
      · 强调色是亮蓝 #60CDFF，所以**强调色上的文字必须是黑的**（TextOnAccentBrush）
      · 卡片底色只有 5% 白（#0DFFFFFF），靠这点微光在云母上"浮"出一层，
        写成不透明的 #2B2B2B 就变成一块死板的深灰板了
  -->

  <sys:Double x:Key="RadiusControl">4</sys:Double>
  <sys:Double x:Key="RadiusCard">8</sys:Double>
  <sys:Double x:Key="RadiusWindow">8</sys:Double>

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- 窗口基层。不支持云母的系统上才用得上这个纯色 -->
  <SolidColorBrush x:Key="WindowBrush" Color="#202020" />

  <!-- 对话框底色，不透明。理由见亮色主题里同一处的注释 -->
  <SolidColorBrush x:Key="DialogBrush" Color="#202020" />

  <!-- 卡片 / 面板 / 导航栏 -->
  <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="#15FFFFFF" />
  <SolidColorBrush x:Key="LayerBrush" Color="#4C3A3A3A" />
  <SolidColorBrush x:Key="NavPaneBrush" Color="#26000000" />

  <!-- 浮出层底色。暗色卡片只有 5% 白，当浮出层用会整块透过去，这里得给实证 -->
  <SolidColorBrush x:Key="FlyoutBrush" Color="#FF2C2C2C" />

  <!-- 控件底色 -->
  <SolidColorBrush x:Key="ControlBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="ControlDisabledBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#08FFFFFF" />

  <!-- 描边 -->
  <SolidColorBrush x:Key="StrokeBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="StrokeStrongBrush" Color="#29FFFFFF" />
  <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
  <SolidColorBrush x:Key="FocusBrush" Color="#60CDFF" />

  <!-- 文字 -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

  <!-- 强调色 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7ED9FF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#48B7E8" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#2660CDFF" />
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#0FFFFFFF" />

  <!-- 状态色 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />

  <!-- 滚动条 -->
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8AFFFFFF" />

  <!-- 日志着色 -->
  <SolidColorBrush x:Key="LogInfoBrush" Color="#E4FFFFFF" />
  <SolidColorBrush x:Key="LogDebugBrush" Color="#87FFFFFF" />

  <!-- 进度条轨道 -->
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ProgressFillBrush" Color="#60CDFF" />

  <!-- 标题栏按钮 -->
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#15FFFFFF" />
  <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />

  <sys:Double x:Key="BodySize">13.5</sys:Double>
  <sys:Double x:Key="CaptionSize">12</sys:Double>
  <sys:Double x:Key="TitleSize">15</sys:Double>
  <sys:Double x:Key="HeaderSize">26</sys:Double>

</ResourceDictionary>
