<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    亮色主题。数值取自 WinUI 3 的 Fluent 令牌（Light 主题），不是随手挑的颜色。

    关键点：**卡片与控件的底色是半透明的**。
    窗口底下铺的是云母（Mica），层次感全靠半透明面片叠出来的——
    如果这里给成不透明的 #FBFBFB，云母就被糊死了，整个界面立刻退回"灰盒子"观感。
  -->

  <sys:Double x:Key="RadiusControl">4</sys:Double>
  <sys:Double x:Key="RadiusCard">8</sys:Double>
  <sys:Double x:Key="RadiusWindow">8</sys:Double>

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- 窗口基层。不支持云母的系统上才用得上这个纯色（Windows 10 及更早） -->
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />

  <!--
    对话框底色，**不透明**。
    对话框不一定开了云母，所以不能像主窗口那样用透明的 WindowBrush 兜底——
    透明的窗口会被 DWM 合成成一片白，暗色下白底白字什么都看不见。
    云母真的开起来了才会被代码换成 Transparent。
  -->
  <SolidColorBrush x:Key="DialogBrush" Color="#F3F3F3" />

  <!-- 卡片 / 面板 / 导航栏：都带 alpha，让云母透出来 -->
  <SolidColorBrush x:Key="CardBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="LayerBrush" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="NavPaneBrush" Color="#66FFFFFF" />

  <!--
    浮出层（下拉菜单 / 右键菜单 / 提示气泡）的底色。
    这里必须比 CardBrush 实得多：浮出层是**悬在内容上面**的，
    用 #B3 那种半透明的话，底下的卡片、大按钮会直接透上来，
    字压在按钮上根本看不清。WinUI 的浮出层用 Acrylic，实际也接近不透明。
  -->
  <SolidColorBrush x:Key="FlyoutBrush" Color="#FFF9F9F9" />

  <!-- 控件底色 -->
  <SolidColorBrush x:Key="ControlBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#80F9F9F9" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#4DF9F9F9" />
  <SolidColorBrush x:Key="ControlDisabledBrush" Color="#4DF9F9F9" />
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0E000000" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#17000000" />

  <!-- 描边。WinUI 的卡片描边本来就只有 6% 黑，很轻 -->
  <SolidColorBrush x:Key="StrokeBrush" Color="#0F000000" />
  <SolidColorBrush x:Key="StrokeStrongBrush" Color="#29000000" />
  <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
  <SolidColorBrush x:Key="FocusBrush" Color="#5B5B5B" />

  <!-- 文字 -->
  <SolidColorBrush x:Key="TextBrush" Color="#E4000000" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C000000" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <!-- 强调色 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A5CA8" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B4A8F" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#26005FB8" />
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#0A000000" />

  <!-- 状态色 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

  <!-- 滚动条 -->
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66000000" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8A000000" />

  <!-- 日志着色 -->
  <SolidColorBrush x:Key="LogInfoBrush" Color="#E4000000" />
  <SolidColorBrush x:Key="LogDebugBrush" Color="#72000000" />

  <!-- 进度条轨道 -->
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1F000000" />
  <SolidColorBrush x:Key="ProgressFillBrush" Color="#005FB8" />

  <!-- 标题栏按钮 -->
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14000000" />
  <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />

  <sys:Double x:Key="BodySize">13.5</sys:Double>
  <sys:Double x:Key="CaptionSize">12</sys:Double>
  <sys:Double x:Key="TitleSize">15</sys:Double>
  <sys:Double x:Key="HeaderSize">26</sys:Double>

</ResourceDictionary>
