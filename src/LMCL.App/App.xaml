<Application x:Class="LMCL.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LMCL.App.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 第 0 本固定是颜色表，ThemeManager 换主题时整本替换 -->
        <ResourceDictionary Source="Themes/Fluent.Light.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 通用转换器放这里，任何页面都能 StaticResource 拿到 -->
      <conv:BoolVisibleConverter x:Key="BoolVisible" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
