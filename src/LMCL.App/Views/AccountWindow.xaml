<Window x:Class="LMCL.App.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LMCL.App.Controls"
        Title="账号管理" Height="680" Width="980" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource AppFont}" FontSize="13.5"
        Foreground="{DynamicResource TextBrush}">

  <!--
    标题栏同样交给 WindowChrome（和主窗口一个套路），拖拽 / 贴边吸附都是系统原生行为。
    CaptionHeight 给 44 而不是 48：对话框比主窗口矮一档，标题条也收一点。
    条里的按钮靠 IsHitTestVisibleInChrome="True" 把点击抢回来。
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="-1"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="Transparent"
          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ══ 标题栏 ══════════════════════════════════════ -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="账号管理" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Close_Click" ToolTip="关闭" />
      </Grid>

      <!-- ══ 主体 ═════════════════════════════════════════ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="272" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 左：账号列表 ──────────────────────────── -->
        <Grid Grid.Column="0" Background="{DynamicResource LayerBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,10">
            <TextBlock Text="已有账号" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Border x:Name="AccountCount" Style="{StaticResource Chip}" Margin="8,0,0,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="AccountCountText" Style="{StaticResource ChipText}" Text="0" />
            </Border>
          </StackPanel>

          <Grid Grid.Row="1">
            <ListBox x:Name="AccountList" Style="{StaticResource PlainList}"
                     Margin="10,0,6,0" SelectionChanged="Account_Changed">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextOnAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                      <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <!--
                          必须显式写 NoWrap。CaptionText 里设了 TextWrapping="Wrap"，
                          外置登录的副标题带一长串服务器地址，不掐掉会把整行撑成三行高，
                          列表立刻变得参差不齐。
                        -->
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                      </StackPanel>

                    <!-- 「当前」徽标。绑数据而不是读选中态：选中的账号不一定是正在用的那个 -->
                    <Border Grid.Column="2" Padding="6,1" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Style="{StaticResource ChipText}" Text="当前" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="ListEmpty" Style="{StaticResource EmptyState}"
                       Text="还没有账号。&#x0a;点下面的「添加账号」加一个。" VerticalAlignment="Top" />
          </Grid>

          <Button Grid.Row="2" x:Name="BtnAddAccount" Style="{StaticResource AccentButton}"
                  Margin="14,12,14,16" HorizontalAlignment="Stretch" Click="AddAccount_Click">
            <!-- 图标必须单独用一个 TextBlock 挂 IconFont：按钮样式把 FontFamily 定成了正文字体，
                 直接写在 Content 里的话图标字形会落不到字体上，显示成方框 -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                         VerticalAlignment="Center" />
              <TextBlock Text="添加账号" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- 竖分割线 -->
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />

        <!-- ── 右：详情 / 添加 ───────────────────────── -->
        <Grid Grid.Column="2">

          <!-- ═ 详情模式 ═ -->
          <Grid x:Name="PaneDetail">
            <!-- 一个账号都没有时的引导 -->
            <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="40"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="还没有任何账号" Style="{StaticResource SectionTitle}"
                         HorizontalAlignment="Center" Margin="0,14,0,0" />
              <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                         TextAlignment="Center" MaxWidth="320" Margin="0,8,0,0"
                         Text="离线账号用来玩单人游戏和本地测试；外置登录用来进用 authlib-injector 的服务器。" />
              <Button Style="{StaticResource AccentButton}"
                      HorizontalAlignment="Center" Margin="0,18,0,0" Click="AddAccount_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                             VerticalAlignment="Center" />
                  <TextBlock Text="添加账号" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Grid x:Name="DetailBody" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!--
                顶栏 = 账号详情 + 皮肤/披风入口。

                皮肤管理搬去了独立的一整页（见下面 PaneSkin）。早先它是一张塞在
                详情滚动区里的巨卡：控件挤成一团，而且几个「标题 + 操作」的 Grid
                忘了写 ColumnDefinitions，按钮直接压在说明文字上。
                现在这里只留一个入口按钮 + 一张当前头像缩略图。
              -->
              <Border Grid.Row="0" Background="{DynamicResource LayerBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                      Padding="24,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                          Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailInitial" Text="?" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="DetailName" Text="—" FontSize="19" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border x:Name="DetailCurrentChip" Style="{StaticResource Chip}"
                              Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource ChipText}" Text="当前使用中" />
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailType" Style="{StaticResource SecondaryText}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!--
                    皮肤 / 披风入口：一张当前头像 + 一个按钮。
                    整块（SkinEntryBlock）对第三方账号会收起 —— 那种账号的材质由
                    服务器决定，留一个点进去只有「改不了」的按钮（和一张空白头像框）
                    比不给入口更糟。
                  -->
                  <StackPanel Grid.Column="2" x:Name="SkinEntryBlock"
                              Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderSkinThumb" Width="44" Height="44" CornerRadius="6"
                            Background="{DynamicResource SubtleHoverBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                      <Image x:Name="HeaderSkinImage" Margin="1"
                             RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <Button x:Name="BtnOpenSkin" Style="{StaticResource AccentButton}"
                            MinWidth="128" Click="OpenSkin_Click"
                            ToolTip="管理这个账号的皮肤与披风">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D3;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="皮肤 / 披风" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Grid.Row="1" Text="账号详情" Style="{StaticResource PageTitle}" FontSize="22"
                         Margin="24,20,24,4" />

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,20,20">
                <StackPanel>
                  <!-- 信息表 -->
                  <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="账号信息" Style="{StaticResource SectionTitle}" />
                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="玩家名"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoName"
                                   Style="{StaticResource BodyText}" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UUID"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoUuid"
                                   Style="{StaticResource MonoText}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="登录方式"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoKind"
                                   Style="{StaticResource BodyText}" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="凭证"
                                   Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoCredential"
                                   Style="{StaticResource BodyText}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 操作 -->
                  <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="操作" Style="{StaticResource SectionTitle}" />
                      <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                 Text="选中左边的账号只是「查看」，不会动到正在用的那个——想真的换过去，点下面这个按钮。" />
                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnSetCurrent" Style="{StaticResource AccentButton}"
                                Content="设为当前账号" Click="SetCurrent_Click" />
                        <Button x:Name="BtnRemove" Style="{StaticResource SubtleButton}"
                                Content="删除这个账号" Margin="10,0,0,0"
                                Foreground="{DynamicResource ErrorBrush}" Click="Remove_Click" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>

          <!-- ═ 皮肤管理（独立一整页） ═
               从详情页的「皮肤 / 披风」按钮进来。分成两栏：
                 左 = 这个账号现在的样子（皮肤 + 披风的大预览）
                 右 = 能做什么（正版：上传/切换皮肤、切换/取消披风；离线：本地皮肤库）
               两栏各自独立排布，不再互相压盖。 -->
          <Grid x:Name="PaneSkin" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页头 + 返回 -->
            <Border Grid.Row="0" Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="24,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="皮肤 / 披风" Style="{StaticResource PageTitle}" FontSize="20" />
                  <TextBlock x:Name="SkinPageSubtitle" Style="{StaticResource CaptionText}"
                             Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                        VerticalAlignment="Center" Click="BackToDetail_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="返回账号详情" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,20,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <!-- 预览栏按内容定宽；右边「可做的事」吃掉剩下的全部宽度 -->
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <!-- ── 左：当前外观 ───────────────────────── -->
                <StackPanel Grid.Column="0" Width="176" Margin="0,0,18,0">
                  <TextBlock Text="当前外观" Style="{StaticResource SectionTitle}" />

                  <TextBlock Text="皮肤" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                  <Border Background="{DynamicResource LayerBrush}"
                          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="10" Margin="0,6,0,0"
                          HorizontalAlignment="Left">
                    <!-- 最近邻缩放：像素画放大后必须还是硬边，不能被插值糊掉 -->
                    <Image x:Name="SkinPreview" Width="140" Height="140" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                  </Border>
                  <TextBlock x:Name="SkinVariantText" Style="{StaticResource CaptionText}"
                             Margin="0,8,0,0" TextWrapping="Wrap" Width="156" />

                  <!--
                    披风只在微软正版账号下才有意义：离线账号没有服务端档案，
                    根本不存在「戴哪条披风」这回事。所以整块（标题 + 预览）
                    跟着 CapeCard 一起收起，不给离线用户看一个永远空着的框。
                  -->
                  <StackPanel x:Name="CapePreviewBlock" Visibility="Collapsed">
                    <TextBlock Text="披风" Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                    <Border x:Name="CapePreviewBox" Background="{DynamicResource LayerBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,6,0,0"
                            HorizontalAlignment="Left">
                      <Image x:Name="CapePreview" Width="68" Height="108" Stretch="Fill"
                             RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock x:Name="CapeNoneText" Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" Text="没有佩戴披风。" Width="156"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                  </StackPanel>
                </StackPanel>

                <!-- ── 右：可做的事 ───────────────────────── -->
                <StackPanel Grid.Column="1">

                  <!-- 正版：服务端皮肤（上传 / 切换 / 重置） -->
                  <Border x:Name="ServerSkinBlock" Style="{StaticResource Card}"
                          Visibility="Collapsed">
                    <StackPanel>
                      <TextBlock Text="我的皮肤" Style="{StaticResource SectionTitle}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                 TextWrapping="Wrap"
                                 Text="点任意一张即可换成它；也可以上传自己的 PNG（64×64 或 64×32）。换的是微软账号上的档案，进任何正版服务器都是这一身。" />

                      <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="BtnSkinUpload" Style="{StaticResource AccentButton}"
                                Content="上传皮肤…" Click="SkinUpload_Click" Margin="0,0,8,8"
                                ToolTip="选一张本地 PNG（64×64 或 64×32）作为新皮肤" />
                        <ComboBox x:Name="SkinModel" Style="{StaticResource Combo}" Width="118"
                                  Margin="0,0,8,8" SelectedIndex="0"
                                  ToolTip="上传时使用的角色模型">
                          <ComboBoxItem Content="经典（Steve）" />
                          <ComboBoxItem Content="纤细（Alex）" />
                        </ComboBox>
                        <Button x:Name="BtnSkinRefresh" Style="{StaticResource SubtleButton}"
                                Content="刷新" Margin="0,0,8,8" Click="SkinRefresh_Click"
                                ToolTip="重新从 Minecraft 服务读取皮肤与披风" />
                        <Button x:Name="BtnSkinReset" Style="{StaticResource SubtleButton}"
                                Content="恢复默认" Margin="0,0,0,8" Click="SkinReset_Click"
                                ToolTip="恢复成默认的 Steve / Alex" />
                      </WrapPanel>

                      <TextBlock Text="可选皮肤" Style="{StaticResource CaptionText}"
                                 Margin="0,18,0,6" />
                      <WrapPanel x:Name="SkinList" />
                      <TextBlock x:Name="SkinListEmpty" Style="{StaticResource CaptionText}"
                                 Text="还没有读到皮肤列表，点上面的「刷新」试试。"
                                 Visibility="Collapsed" />
                    </StackPanel>
                  </Border>

                  <!-- 正版：披风 -->
                  <Border x:Name="CapeCard" Style="{StaticResource Card}" Margin="0,12,0,0"
                          Visibility="Collapsed">
                    <StackPanel>
                      <TextBlock Text="我的披风" Style="{StaticResource SectionTitle}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                 TextWrapping="Wrap"
                                 Text="披风只能从你已经拥有的里面挑，没有上传入口——这是 Mojang 那边的限制。" />

                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnCapeNone" Style="{StaticResource SubtleButton}"
                                Content="不戴披风" Click="CapeNone_Click"
                                ToolTip="取消当前佩戴的披风" />
                      </StackPanel>

                      <TextBlock Text="拥有的披风" Style="{StaticResource CaptionText}"
                                 Margin="0,18,0,6" />
                      <WrapPanel x:Name="CapeList" />
                      <TextBlock x:Name="CapeListEmpty" Style="{StaticResource CaptionText}"
                                 Text="这个账号还没有任何披风。"
                                 Visibility="Collapsed" />
                    </StackPanel>
                  </Border>

                  <!-- 本地皮肤库（离线账号用；正版账号也能用来自娱自乐） -->
                  <Border x:Name="LocalSkinCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="本地皮肤库" Style="{StaticResource SectionTitle}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                 TextWrapping="Wrap"
                                 Text="Steve / Alex 是启动器自带的。下面可以导入你自己的 PNG（64×64 或 64×32），一次可以选多张，每张都会成为独立的一张皮肤。离线账号用的就是这一套（只存在本机，别人看不到）。" />

                      <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="BtnSkinImport" Style="{StaticResource AccentButton}"
                                Content="导入皮肤…" Click="SkinImport_Click" Margin="0,0,8,8"
                                ToolTip="可以一次选多张 PNG，每张成为一张独立皮肤" />
                        <ComboBox x:Name="LocalSkinModel" Style="{StaticResource Combo}" Width="118"
                                  SelectedIndex="0" Margin="0,0,8,8"
                                  ToolTip="导入皮肤时使用的角色模型">
                          <ComboBoxItem Content="经典（Steve）" />
                          <ComboBoxItem Content="纤细（Alex）" />
                        </ComboBox>
                      </WrapPanel>

                      <TextBlock Text="内置" Style="{StaticResource CaptionText}" Margin="0,10,0,6" />
                      <WrapPanel x:Name="BuiltInSkinList" />

                      <TextBlock Text="我导入的皮肤" Style="{StaticResource CaptionText}"
                                 Margin="0,16,0,6" />
                      <WrapPanel x:Name="UserSkinList" />
                      <TextBlock x:Name="UserSkinEmpty" Style="{StaticResource CaptionText}"
                                 Text="还没有导入过皮肤。点上面的「导入皮肤…」加一张。"
                                 Visibility="Collapsed" />

                      <TextBlock x:Name="LocalSkinState" Style="{StaticResource CaptionText}"
                                 Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <!-- 进度 + 状态 -->
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <controls:MarqueeBar x:Name="SkinMarquee" Width="200" Height="4"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                  </StackPanel>
                  <TextBlock x:Name="SkinStatus" Style="{StaticResource CaptionText}"
                             Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>

          <!-- ═ 添加模式 ═ -->
          <Grid x:Name="PaneAdd" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,20,0">
              <StackPanel>
                <TextBlock Text="添加账号" Style="{StaticResource PageTitle}" FontSize="22" />
                <TextBlock x:Name="AddHint" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
              </StackPanel>

              <Button Style="{StaticResource SubtleButton}"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Click="BackToDetail_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                             VerticalAlignment="Center" />
                  <TextBlock Text="返回账号详情" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!--
              分段控件（胶囊）而不是下划线页签：这里选的是「用哪种方式登录」，
              是一组互斥的做法，不是同一份内容的几个视图。
              页签项在 BuildTabs() 里生成——微软正版暂时收起，用一个开关控制，
              写死在 XAML 里的话收起中间那项就得手工挪后面的索引，很容易对错。
            -->
            <StackPanel Grid.Row="1">
              <ListBox x:Name="Tabs" Style="{StaticResource Segmented}" Margin="24,16,0,0"
                       SelectionChanged="Tabs_Changed" />

              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,20,20">
                <Grid>

                  <!-- ── 离线 ───────────────────────────── -->
                  <StackPanel x:Name="PanelOffline" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="玩家名" Style="{StaticResource BodyText}" />
                        <TextBox x:Name="OfflineName" Style="{StaticResource InputBox}" Width="260"
                                 HorizontalAlignment="Left" Margin="0,8,0,0" MaxLength="16" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Text="最多 16 个字符。离线身份的 UUID 是按名字算出来的，所以同样的名字在任何电脑上都是同一个人。" />
                        <Button Style="{StaticResource AccentButton}" Content="添加"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="AddOffline_Click" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- ── 微软 ───────────────────────────── -->
                  <StackPanel x:Name="PanelMicrosoft" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="点「打开浏览器登录」后，在微软自己的页面上登录（密码不经过启动器）。登录完浏览器会停在一个 login.live.com 的页面，把地址栏里 code= 后面的内容（或直接粘整段网址）粘回这里就行。" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                      <StackPanel>
                        <TextBlock Text="第一步：打开浏览器登录" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" />
                        <Button x:Name="BtnMsaStart" Style="{StaticResource AccentButton}"
                                Content="打开浏览器登录" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="MsaBegin_Click" />

                        <!-- 粘贴授权码：点开浏览器之后才出现 -->
                        <StackPanel x:Name="MsaPaste" Visibility="Collapsed" Margin="0,16,0,0">
                          <TextBlock Text="第二步：把浏览器地址栏里的授权码粘回来" Style="{StaticResource BodyText}"
                                     FontWeight="SemiBold" />
                          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                     Text="地址形如 https://login.live.com/oauth20_desktop.srf?code=…… 把整段网址粘进来，或只粘 code= 后面那一长串。" />
                          <TextBox x:Name="MsaCode" Style="{StaticResource InputBox}" Width="420"
                                   HorizontalAlignment="Left" Margin="0,10,0,0" Height="64"
                                   TextWrapping="Wrap" AcceptsReturn="True"
                                   VerticalScrollBarVisibility="Auto"
                                   ToolTip="把浏览器登录后地址栏里的 code 粘到这里" />
                          <Button x:Name="BtnMsaFinish" Style="{StaticResource AccentButton}"
                                  Content="完成登录" HorizontalAlignment="Left" Margin="0,14,0,0"
                                  Click="MsaFinish_Click" />
                        </StackPanel>

                        <!-- 登录进行中：跑马灯 + 取消 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <controls:MarqueeBar x:Name="MsaMarquee" Width="220" Height="4"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                          <Button x:Name="BtnMsaCancel" Style="{StaticResource SubtleButton}"
                                  Content="取消" Margin="12,0,0,0" Visibility="Collapsed"
                                  Click="MsaCancel_Click" />
                        </StackPanel>

                        <TextBlock x:Name="MsaStatus" Style="{StaticResource CaptionText}" Margin="0,14,0,0"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="登录完之后" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                   Text="启动器会拿到一个刷新令牌，之后启动游戏时如果凭证过期会自动续期，不用反复登录。" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                                   Text="令牌只存在本机的 %APPDATA%\LMCL\accounts.json 里。共用电脑的话，用完记得把账号删掉。" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- ── 外置登录 ───────────────────────── -->
                  <StackPanel x:Name="PanelThird" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="验证服务器地址" Style="{StaticResource BodyText}" />
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <!-- 第一列用 Auto：用 * 的话输入框靠左、按钮被推到卡片最右边，
                                 两者离得老远，看着像没关系 -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Grid.Column="0" x:Name="ThirdServer" Style="{StaticResource InputBox}"
                                   Width="330"
                                   ToolTip="形如 https://example.com/api/yggdrasil" />
                          <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="检测"
                                  Margin="8,0,0,0" VerticalAlignment="Stretch" Click="ThirdProbe_Click" />
                        </Grid>
                        <TextBlock x:Name="ThirdProbeHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                        <TextBlock Text="账号" Style="{StaticResource BodyText}" Margin="0,16,0,0" />
                        <TextBox x:Name="ThirdUser" Style="{StaticResource InputBox}" Width="260"
                                 HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <TextBlock Text="密码" Style="{StaticResource BodyText}" Margin="0,16,0,0" />
                        <PasswordBox x:Name="ThirdPassword" Style="{StaticResource InputPasswordBox}"
                                     Width="260" HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <TextBlock x:Name="ThirdStatus" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />

                        <Button x:Name="BtnThirdLogin" Style="{StaticResource AccentButton}"
                                Content="登录并添加" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Click="ThirdLogin_Click" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="外置登录组件" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="游戏客户端只认 Mojang 的验证服务器，要让它认这台第三方服务器，得在启动时挂一个 authlib-injector 的 javaagent。这一份启动器会自动下载并在启动时挂上，不需要你手动填参数。" />
                        <TextBlock x:Name="InjectorStatus" Style="{StaticResource CaptionText}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                          <Button x:Name="BtnInjector" Style="{StaticResource SubtleButton}"
                                  Content="现在准备" Click="InjectorPrepare_Click" />
                          <Button Style="{StaticResource SubtleButton}" Content="打开所在目录"
                                  Margin="8,0,0,0" Click="InjectorFolder_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- ══ 底部状态条 ═══════════════════════════════════ -->
      <Border Grid.Row="2" Background="{DynamicResource LayerBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="16,0" Height="34">
        <Grid>
          <TextBlock x:Name="FooterText" Style="{StaticResource SecondaryText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Style="{StaticResource LinkButton}" Content="关闭"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
