<Window x:Class="LMCL.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LMCL.App.Controls"
        Title="LMCL"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource AppFont}" FontSize="13.5"
        Foreground="{DynamicResource TextBrush}">

  <!--
    标题栏用 WindowChrome 交给系统：CaptionHeight=48 让顶部那一条**真正成为非客户区**，
    于是拖拽、双击最大化、Aero Snap（拖到屏幕边缘吸附）、右键系统菜单全是系统原生行为，
    不用自己写一行。条里的按钮靠 IsHitTestVisibleInChrome="True" 把点击抢回来。

    GlassFrameThickness="-1" 把 DWM 框体铺满整个窗口，这是云母能透进内容区的前提；
    配合窗口背景透明（ThemeManager.SetTranslucentBackdrop），云母才真的看得见。
    之前这两处一个写 0、一个给 WindowBrush 铺了不透明底，云母等于白设置。

    ResizeBorderThickness 留 6，保证窗口边缘还能拖拽缩放。
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="-1"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <!--
      ══ 自定义背景图层（铺在最底下）══════════════════════

      它必须在所有内容之下，而且只在「背景效果 = 自定义图片」时才显示。
      模糊和明暗都是**在 C# 里按像素预处理**好再塞进来的（见 ThemeManager.PrepareBackground），
      不用 XAML 的 BlurEffect —— 那个依赖像素着色器，在没有硬件加速的环境里
      （远程桌面 / 虚拟机 / 老显卡）会把整个元素画不出来，表现成「一开模糊背景就变纯色」。
    -->
    <Image x:Name="CustomBackground" Stretch="UniformToFill"
           Visibility="Collapsed" IsHitTestVisible="False" />

    <!--
      背景明暗遮罩。云母 / 亚克力模式下没法直接调系统材质的亮度，
      就在它上面盖一层黑（变暗）或白（变亮）的半透明膜；
      自定义图片模式不用它（图已经逐像素调过了）。
    -->
    <Rectangle x:Name="BackgroundTint" Visibility="Collapsed" IsHitTestVisible="False" />

    <Grid>
      <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ══ 标题栏（系统非客户区）════════════════════════ -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 应用图标 + 名字 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0"
                  VerticalAlignment="Center">
        <Border Width="20" Height="20" CornerRadius="5"
                Background="{DynamicResource AccentBrush}">
          <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                     Foreground="{DynamicResource TextOnAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="LMCL" Margin="9,0,0,0" VerticalAlignment="Center"
                   FontSize="13" FontWeight="SemiBold" />
        <TextBlock x:Name="TitleVersion" Margin="7,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>

      <!--
        账号条。这一块是 PCL 最值得抄的地方：换账号不该开新窗口，
        点一下弹个菜单、选一个就换过去了，管理账号才是菜单最后那一项。

        必须抢回命中测试，否则标题栏（系统非客户区）会把点击吞掉。
      -->
      <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="AccountChip" Click="AccountChip_Click"
                Padding="8,0" Height="36" MinHeight="0" MaxHeight="36" Cursor="Hand"
                Style="{StaticResource SubtleButton}"
                AutomationProperties.AutomationId="AccountChip"
                ToolTip="切换账号">
          <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
              <TextBlock x:Name="AccountInitial" Text="?" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextOnAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
              <TextBlock x:Name="AccountName" Text="未登录" FontSize="12.5"
                         MaxWidth="140" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="AccountType" Text="点击添加账号" FontSize="10.5"
                         Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="9"
                       Margin="4,0,2,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
        </Button>

        <!--
          账号菜单。

          定位这块踩过一次坑，写下来省得下次再试：
          「Placement=Bottom」在 WPF 里是**按目标的右边缘右对齐**的，
          实测 popup.left = 目标.right - popup.宽 + HorizontalOffset。
          一开始按「左对齐、自己减 (菜单宽-账号条宽)」去算，等于多减了一个菜单宽，
          菜单整整偏出一个自身宽度。既然本来就右对齐，HorizontalOffset 留 0 即可，
          菜单右边缘自然和账号条右边缘齐平。
        -->
        <Popup x:Name="AccountPopup" Placement="Bottom"
               PlacementTarget="{Binding ElementName=AccountChip}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               VerticalOffset="6">
          <Border Style="{StaticResource PopupSurface}" Width="296">
            <StackPanel>
              <TextBlock x:Name="MenuCaption" Text="切换账号" Style="{StaticResource CaptionText}"
                         Margin="14,6,14,6" />

              <ListBox x:Name="AccountMenu" Style="{StaticResource PopupList}"
                       MaxHeight="300" SelectionChanged="AccountMenu_Changed">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                              Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                      </StackPanel>

                      <!--
                        勾必须靠 Style 里的 Setter 控制可见性，不能在标签上写 Visibility="Collapsed"：
                        那样是**局部值**，优先级高于 Style 触发器，DataTrigger 永远改不动它，
                        结果就是当前账号这一行根本看不到勾。
                      -->
                      <TextBlock Grid.Column="2" Text="&#xE73E;"
                                 FontFamily="{DynamicResource IconFont}" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="6,0,2,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="MenuEmpty" Style="{StaticResource CaptionText}" Margin="14,8,14,10"
                         Text="还没有账号。" Visibility="Collapsed" />

              <Border Style="{StaticResource Divider}" Margin="4,4" />

              <Button x:Name="MenuManage" Style="{StaticResource SubtleButton}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Padding="12,8" Margin="4,0,4,4" Click="ManageAccounts_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                             VerticalAlignment="Center" />
                  <TextBlock Text="管理账号…" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- 系统风格的窗口按钮：46×32，关闭键悬停变红 -->
      <StackPanel Grid.Column="3" Orientation="Horizontal"
                  VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}"
                Content="&#xE921;" Click="BtnMinimize_Click" ToolTip="最小化" />
        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}"
                Content="&#xE922;" Click="BtnMaximize_Click" ToolTip="最大化" />
        <Button Style="{StaticResource CaptionCloseButton}"
                Content="&#xE8BB;" Click="BtnClose_Click" ToolTip="关闭" />
      </StackPanel>
    </Grid>

    <!-- ══ 主体 ═════════════════════════════════════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ── 左侧导航 ─────────────────────────────────── -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="Nav" Grid.Row="0" Margin="0,2,0,0" Style="{StaticResource PlainNav}"
                 SelectionChanged="Nav_SelectionChanged">

          <ListBoxItem Style="{StaticResource NavItem}" Tag="home">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource IconFont}"
                         FontSize="16" VerticalAlignment="Center" Width="26" />
              <TextBlock Text="主页" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Style="{StaticResource NavItem}" Tag="download">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}"
                         FontSize="16" VerticalAlignment="Center" Width="26" />
              <TextBlock Text="下载" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Style="{StaticResource NavItem}" Tag="versions">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource IconFont}"
                         FontSize="16" VerticalAlignment="Center" Width="26" />
              <TextBlock Text="版本与资源" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Style="{StaticResource NavItem}" Tag="log">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}"
                         FontSize="16" VerticalAlignment="Center" Width="26" />
              <TextBlock Text="运行日志" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Style="{StaticResource NavItem}" Tag="settings">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}"
                         FontSize="16" VerticalAlignment="Center" Width="26" />
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>

        <!-- ── 左下角状态摘要 ─────────────────────────── -->
        <StackPanel Grid.Row="1" Margin="16,8,16,14">
          <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
          <TextBlock x:Name="SideJava" Text="Java：检测中…" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SideSource" Text="下载源：—" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <!-- ── 内容区 ───────────────────────────────────── -->
      <ContentControl Grid.Column="1" x:Name="Host" />
    </Grid>

    <!-- ══ 底部状态条 ═══════════════════════════════════ -->
    <Border Grid.Row="2" Background="{DynamicResource LayerBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
            Padding="16,0" Height="32">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪"
                   Style="{StaticResource SecondaryText}" MaxHeight="16"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <controls:MarqueeBar x:Name="StatusMarquee" Grid.Column="1" Width="160"
                             Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" />

        <ProgressBar x:Name="StatusProgress" Grid.Column="1" Width="160" Margin="12,0"
                     VerticalAlignment="Center" Maximum="1" Style="{StaticResource Progress}"
                     Visibility="Collapsed" />

        <TextBlock x:Name="StatusPercent" Grid.Column="2" Style="{StaticResource SecondaryText}"
                   VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
