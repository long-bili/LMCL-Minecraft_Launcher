<pages:PageBase x:Class="LMCL.App.Views.Pages.SettingsPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <!--
    全局设置内部是「左侧二级分类 + 右侧内容」。
    改动即时保存，没有保存按钮——设置这种东西还要记得按保存，纯属找茬。
  -->
  <Grid Margin="24,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ══ 标题 ══════════════════════════════════════════ -->
    <Grid Grid.Row="0" Margin="0,0,6,14">
      <StackPanel>
        <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                   Text="全局默认值、工具与帮助都在这一页。单个版本想不一样，去「版本与资源 → 版本设置」单独覆盖。" />
      </StackPanel>
      <Button Style="{StaticResource SubtleButton}" Content="打开配置文件" HorizontalAlignment="Right"
              VerticalAlignment="Top" Click="OpenConfig_Click" />
    </Grid>

    <!-- ══ 一级分栏 ══════════════════════════════════════ -->
    <ListBox Grid.Row="1" x:Name="Tabs" Style="{StaticResource TabStrip}"
             SelectionChanged="Tabs_Changed">
      <ListBoxItem Content="全局设置" />
      <ListBoxItem Content="工具" />
      <ListBoxItem Content="帮助" />
    </ListBox>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom"
            Background="{DynamicResource DividerBrush}" />

    <!-- ══ 全局设置：二级分类导航 + 分类内容 ══════════════ -->
    <Grid Grid.Row="2" x:Name="SettingsPane" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 二级导航。图标沿用侧栏那套 NavItem 样式，保持观感一致 -->
      <ListBox x:Name="CategoryList" Style="{StaticResource PlainList}"
               Margin="0,0,12,4" SelectionChanged="Category_Changed">
        <ListBoxItem Style="{StaticResource NavItem}" Tag="dirs">
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}"
                       FontSize="15" VerticalAlignment="Center" Width="26" />
            <TextBlock Text="下载" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Style="{StaticResource NavItem}" Tag="look">
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <TextBlock Text="&#xE790;" FontFamily="{DynamicResource IconFont}"
                       FontSize="15" VerticalAlignment="Center" Width="26" />
            <TextBlock Text="外观" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Style="{StaticResource NavItem}" Tag="version">
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource IconFont}"
                       FontSize="15" VerticalAlignment="Center" Width="26" />
            <TextBlock Text="版本" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Style="{StaticResource NavItem}" Tag="speed">
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <TextBlock Text="&#xEC4A;" FontFamily="{DynamicResource IconFont}"
                       FontSize="15" VerticalAlignment="Center" Width="26" />
            <TextBlock Text="性能" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Style="{StaticResource NavItem}" Tag="java">
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <TextBlock Text="&#xE943;" FontFamily="{DynamicResource IconFont}"
                       FontSize="15" VerticalAlignment="Center" Width="26" />
            <TextBlock Text="Java" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

          <!-- ══ 下载 ════════════════════════════════════ -->
          <StackPanel x:Name="PaneDirs">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="下载源" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="镜像更快，源上没有的会自动回退官方" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="SourceCombo" Style="{StaticResource Combo}"
                            Width="260" HorizontalAlignment="Left"
                            SelectionChanged="SourceCombo_Changed" />
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="同时下载文件数" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="镜像并发太高会返回 429，8 是实测稳的档位" />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="ThreadsBox" Style="{StaticResource InputBox}"
                           Width="110" HorizontalAlignment="Left" LostFocus="ThreadsBox_LostFocus" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ 外观 ════════════════════════════════════ -->
          <StackPanel x:Name="PaneLook" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="主题" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="改完立刻生效" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="ThemeCombo" Style="{StaticResource Combo}"
                            Width="200" HorizontalAlignment="Left"
                            SelectionChanged="ThemeCombo_Changed" />
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="强调色" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="按钮、选中态、导航指示条都用它。选一组预设，或者自己调 RGB。" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <!-- 预设 + 自定义：一个下拉选来源 -->
                    <ComboBox x:Name="AccentCombo" Style="{StaticResource Combo}"
                              Width="200" HorizontalAlignment="Left"
                              SelectionChanged="AccentCombo_Changed" />

                    <!--
                      RGB 调色盘。只有选到「自定义」才展开，免得平时占地方。
                      三个滑杆 + 一块实时预览，调完立刻生效（和别的设置一样即时保存，
                      但拖动过程里不写盘，松手才存，不然拖一次要写几十遍）。
                    -->
                    <StackPanel x:Name="AccentCustomPanel" Margin="0,12,0,0"
                                Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <Border x:Name="AccentPreviewSwatch" Width="56" Height="56"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                          <TextBlock x:Name="AccentPreviewText" Style="{StaticResource MonoText}"
                                     FontSize="12" />
                          <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                     Text="拖动滑杆即可实时预览，松手后保存。" />
                        </StackPanel>
                      </StackPanel>

                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition Width="*" MaxWidth="320" />
                          <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R"
                                   Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="AccentR" Minimum="0"
                                Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                Margin="0,0,10,0" VerticalAlignment="Center"
                                ValueChanged="AccentRgb_Changed"
                                Thumb.DragCompleted="AccentSlider_DragCompleted" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="AccentRText"
                                   Style="{StaticResource MonoText}" FontSize="12"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G"
                                   Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="AccentG" Minimum="0"
                                Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                Margin="0,8,10,0" VerticalAlignment="Center"
                                ValueChanged="AccentRgb_Changed"
                                Thumb.DragCompleted="AccentSlider_DragCompleted" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AccentGText"
                                   Style="{StaticResource MonoText}" FontSize="12"
                                   Margin="0,8,0,0" VerticalAlignment="Center"
                                   TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B"
                                   Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="AccentB" Minimum="0"
                                Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                Margin="0,8,10,0" VerticalAlignment="Center"
                                ValueChanged="AccentRgb_Changed"
                                Thumb.DragCompleted="AccentSlider_DragCompleted" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AccentBText"
                                   Style="{StaticResource MonoText}" FontSize="12"
                                   Margin="0,8,0,0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="背景效果" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="云母只吃桌面色调；亚克力是糊过的桌面；也可以用自己的图片。" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="BackdropCombo" Style="{StaticResource Combo}"
                            Width="200" HorizontalAlignment="Left"
                            SelectionChanged="BackdropCombo_Changed" />
                </Grid>

                <!-- ══ 自定义背景图（选了「自定义图片」才展开）════ -->
                <StackPanel x:Name="BackgroundImagePanel" Margin="0,14,0,0"
                            Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="背景图片" Style="{StaticResource BodyText}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                 TextWrapping="Wrap"
                                 Text="支持 PNG / JPG / BMP。图片会铺满整个窗口。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="选择图片…"
                                Click="PickBackground_Click" />
                        <Button x:Name="BtnClearBackground" Style="{StaticResource SubtleButton}"
                                Content="清除" Margin="8,0,0,0" Click="ClearBackground_Click" />
                      </StackPanel>
                      <TextBlock x:Name="BackgroundPathText" Style="{StaticResource MonoText}"
                                 FontSize="11.5" Margin="0,8,0,0" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="铺法" Style="{StaticResource BodyText}" />
                    <ComboBox Grid.Column="1" x:Name="StretchCombo" Style="{StaticResource Combo}"
                              Width="200" HorizontalAlignment="Left"
                              SelectionChanged="StretchCombo_Changed" />
                  </Grid>
                </StackPanel>

                <!-- ══ 观感微调：通透度 / 模糊 / 明暗 ══ -->
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="通透度" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="面板的不透明程度。调低能透出背景，清晰度会下降。" />
                  </StackPanel>
                  <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MaxWidth="320" />
                      <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="TransparencySlider" Minimum="0.15"
                            Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            ValueChanged="Transparency_Changed"
                            Thumb.DragCompleted="AppearanceSlider_DragCompleted" />
                    <TextBlock Grid.Column="1" x:Name="TransparencyText"
                               Style="{StaticResource MonoText}" FontSize="12"
                               VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="背景模糊" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="把背景糊掉能拉开前后层次。0 = 不模糊。" />
                  </StackPanel>
                  <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MaxWidth="320" />
                      <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="BlurSlider" Minimum="0" Maximum="40"
                            TickFrequency="1" Margin="0,0,10,0" VerticalAlignment="Center"
                            ValueChanged="Blur_Changed"
                            Thumb.DragCompleted="AppearanceSlider_DragCompleted" />
                    <TextBlock Grid.Column="1" x:Name="BlurText" Style="{StaticResource MonoText}"
                               FontSize="12" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="背景明暗" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="往左压暗、往右提亮。背景太花时压暗一点更好读。" />
                  </StackPanel>
                  <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MaxWidth="320" />
                      <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="BrightnessSlider" Minimum="0.2"
                            Maximum="2" TickFrequency="0.05" Margin="0,0,10,0"
                            VerticalAlignment="Center" ValueChanged="Brightness_Changed"
                            Thumb.DragCompleted="AppearanceSlider_DragCompleted" />
                    <TextBlock Grid.Column="1" x:Name="BrightnessText"
                               Style="{StaticResource MonoText}" FontSize="12"
                               VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="启动后最小化" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="点启动就把启动器收起来，不挡游戏" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" x:Name="HideSwitch" Style="{StaticResource Switch}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Checked="HideSwitch_Changed" Unchecked="HideSwitch_Changed" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ 版本 ════════════════════════════════════ -->
          <StackPanel x:Name="PaneVersion" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="版本" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="新版本默认独立" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="新装的版本默认把 mods 和存档放进自己的目录" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" x:Name="DefaultIsolateSwitch" Style="{StaticResource Switch}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Checked="DefaultIsolateSwitch_Changed"
                            Unchecked="DefaultIsolateSwitch_Changed" />
                </Grid>

                <TextBlock Style="{StaticResource CaptionText}" Margin="170,10,0,0" TextWrapping="Wrap"
                           Text="单个版本还可以在「版本与资源 → 版本设置」里单独改。" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ 性能 ════════════════════════════════════ -->
          <StackPanel x:Name="PaneSpeed" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="性能" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                           Text="新建的版本都会用这里的值，之后可以在「版本设置」里单独改。" />
                <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="最大内存（MB）" Style="{StaticResource BodyText}"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="MaxMemBox" Style="{StaticResource InputBox}" Width="110"
                             LostFocus="MaxMemBox_LostFocus" />
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Margin="10,0,0,0" Text="建议 2048～8192" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="最小内存（MB）" Style="{StaticResource BodyText}"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" x:Name="MinMemBox" Style="{StaticResource InputBox}"
                           Width="110" HorizontalAlignment="Left" LostFocus="MinMemBox_LostFocus" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ Java ════════════════════════════════════ -->
          <StackPanel x:Name="PaneJava" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Java" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                           Text="本机没有合适 Java 时，启动器会让客户端自动下载一份 Mojang 运行时，一般不用管。" />
                <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="自动选择 Java" Style="{StaticResource BodyText}"
                             VerticalAlignment="Center" />
                  <CheckBox Grid.Column="1" x:Name="AutoJavaSwitch" Style="{StaticResource Switch}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Checked="AutoJavaSwitch_Changed"
                            Unchecked="AutoJavaSwitch_Changed" />
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="默认 Java 路径" Style="{StaticResource BodyText}"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="JavaCombo" Style="{StaticResource Combo}" Width="320"
                              MaxDropDownHeight="300" SelectionChanged="JavaCombo_Changed" />
                    <Button Style="{StaticResource SubtleButton}" Content="浏览" Margin="8,0,0,0"
                            Click="BrowseJava_Click" />
                    <Button Style="{StaticResource SubtleButton}" Content="重新检测" Margin="8,0,0,0"
                            Click="DetectJava_Click" />
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="JavaHint" Style="{StaticResource CaptionText}" Margin="170,10,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ContentControl x:Name="ToolsHost" Grid.Row="2" Visibility="Collapsed" />
    <ContentControl x:Name="HelpHost" Grid.Row="2" Visibility="Collapsed" />

    <!-- ══ 底部操作条：只有「恢复默认」（改动都即时保存了）════ -->
    <Border x:Name="SaveBar" Grid.Row="3" Margin="0,12,0,0">
      <Grid>
        <TextBlock x:Name="SaveHint" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        <Button Style="{StaticResource SubtleButton}" Content="恢复默认设置"
                HorizontalAlignment="Right" Click="Reset_Click" />
      </Grid>
    </Border>
  </Grid>
</pages:PageBase>
