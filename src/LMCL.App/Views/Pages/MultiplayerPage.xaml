<pages:PageBase x:Class="LMCL.App.Views.Pages.MultiplayerPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               xmlns:mp="clr-namespace:LMCL.App.Views.Pages.Multiplayer"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <pages:PageBase.Resources>
    <!-- ══ 照 Campfire 的版式小件 ══ -->
    <!-- 提示框（PclHint）：浅层底、圆角 -->
    <Style x:Key="HintCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <!-- 统计：小灰标签 + 大值 -->
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 进行步骤：灰点 → 亮环 → 绿勾 -->
    <DataTemplate x:Key="StepTemplate">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource DividerBrush}" />
          <Ellipse x:Name="Ring" Width="11" Height="11" StrokeThickness="2"
                   Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed" />
          <Border x:Name="Check" CornerRadius="8" Background="#2EA043" Visibility="Collapsed"
                  Width="16" Height="16">
            <Path Data="M4.6,8.2 L7,10.4 L11.4,5.8" Stroke="White" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stretch="None" Width="16" Height="16" />
          </Border>
        </Grid>
        <TextBlock x:Name="LabTitle" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Title}" />
        <TextBlock x:Name="LabDetail" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" />
      </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Active">
            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            <Setter TargetName="LabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Done">
            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            <Setter TargetName="LabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
          </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- 房间里的人：首字圆标 + 名字 + 身份小签 -->
    <DataTemplate x:Key="PlayerTemplate">
      <Grid Margin="0,3,6,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="30" Height="30" CornerRadius="4" Background="{DynamicResource DividerBrush}">
          <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
            <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                    Background="{DynamicResource DividerBrush}"
                    Visibility="{Binding HasTag, Converter={StaticResource BoolVisible}}">
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Tag}" />
            </Border>
          </StackPanel>
          <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Address}" />
      </Grid>
    </DataTemplate>
    <!-- 工具行：圆图标 + 名称与状态 + 右侧按钮 -->
    <Style x:Key="ToolRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,5" />
    </Style>
    <Style x:Key="ToolIcon" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolState" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 入口瓷贴（沿用） -->
    <Style x:Key="HubTile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <!-- Button 的默认 Foreground 是系统黑，会阻断继承 —— 深色主题下瓷贴文字会变黑字 -->
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Tile" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource DividerBrush}"
                    Background="{DynamicResource CardBrush}" Padding="16,14">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource DividerBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileIcon" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style x:Key="TileGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 大厅/最近房间行：悬停亮底的整行按钮 -->
    <Style x:Key="EntryRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <!-- 同上：不设的话行内未显式着色的文字在深色主题下是黑的 -->
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" CornerRadius="6" Padding="10,9" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource LayerBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource DividerBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 房间小圆图标（首字） -->
    <Style x:Key="RoomIconCircle" TargetType="Border">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RoundIconBtn" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="PanHover" Background="{DynamicResource DividerBrush}" CornerRadius="15" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PanHover" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </pages:PageBase.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ 头部：标题 + 返回键 ══ -->
    <StackPanel Margin="24,18,20,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BtnBack" Style="{StaticResource SubtleButton}" Content="&#xE72B;"
                FontFamily="{DynamicResource IconFont}" FontSize="14"
                Padding="8,4" MinWidth="0" Visibility="Collapsed"
                Click="Back_Click" ToolTip="返回" />
        <TextBlock x:Name="HeaderTitle" Text="多人联机" Style="{StaticResource PageTitle}" />
      </StackPanel>
      <Border Style="{StaticResource Divider}" Margin="0,10,4,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="22,14,22,14">

      <!-- ════════════════ 入口瓷贴 ════════════════ -->
      <ScrollViewer x:Name="PaneHub" VerticalScrollBarVisibility="Auto" Padding="2,0,2,0">
        <StackPanel>
          <!-- 房间开着时：常驻状态条，点了直接回到房间页 -->
          <Border x:Name="RoomCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="RoomCardIcon" Text="&#xE710;" FontFamily="{DynamicResource IconFont}"
                             FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock x:Name="RoomCardTitle" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock x:Name="RoomCardState" Style="{StaticResource CaptionText}" Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="RoomCardCode" Style="{StaticResource MonoText}" FontSize="14" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnResumeRoom" Style="{StaticResource SubtleButton}" Content="回到房间"
                        Click="ResumeRoom_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnLeaveRoom" Style="{StaticResource SubtleButton}" Content="退出房间"
                        Click="LeaveRoom_Click" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="多人联机" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="create">
              <StackPanel>
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE710;" />
                </Border>
                <TextBlock Text="创建房间" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="开放世界并邀请其他玩家" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="join">
              <StackPanel>
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE724;" />
                </Border>
                <TextBlock Text="加入房间" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="输入房主提供的邀请码" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="lobby">
              <StackPanel>
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE721;" />
                </Border>
                <TextBlock Text="联机大厅" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="浏览并加入公开房间" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="recent">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE823;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="最近房间" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock Text="再次进入用过的房间" FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="settings">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE713;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="联机设置" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock Text="名称、节点与数据" FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource HubTile}" Click="HubTile_Click" Tag="repair">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource TileIcon}">
                  <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE90F;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="修复工具" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock Text="组件重装、网络检测与缓存清理" FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ════════════════ 加入房间（照 Campfire PanJoin） ════════════════ -->
      <Grid x:Name="PaneJoin" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="邀请码" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="JoinCodeBox" Height="38" FontSize="16" Style="{StaticResource InputBox}"
                         FontFamily="{DynamicResource AppFont}" MaxLength="64"
                         ToolTip="U/XXXX-XXXX-XXXX-XXXX"
                         TextChanged="JoinCodeBox_TextChanged" KeyDown="JoinCodeBox_KeyDown" />
                <Button Grid.Column="1" Height="38" MinWidth="88" Margin="10,0,0,0"
                        Style="{StaticResource SubtleButton}" Content="粘贴" Click="Paste_Click" />
              </Grid>
              <TextBlock x:Name="LabJoinCodeState" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="支持粘贴含邀请码的整段消息。" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HintCard}" Margin="0,15,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="请确认房主已开启房间，且双方游戏版本一致。" />
          </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Button x:Name="BtnGoLobby" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}"
                  Content="前往联机大厅" Click="GoLobby_Click" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SubtleButton}" Content="返回" Click="Back_Click" />
            <Button x:Name="BtnJoinConfirm" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                    Style="{StaticResource AccentButton}" Content="加入房间" IsEnabled="False"
                    Click="JoinConfirm_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ════════════════ 进行中（照 Campfire PanWorking） ════════════════ -->
      <Grid x:Name="PaneWorking" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <ItemsControl x:Name="WorkSteps" Focusable="False" ItemTemplate="{StaticResource StepTemplate}" />
              <ProgressBar x:Name="WorkProgress" Margin="26,4,0,4" Height="4"
                           Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <Border x:Name="WorkHint" Style="{StaticResource HintCard}" Margin="0,15,0,0" Visibility="Collapsed">
            <TextBlock x:Name="LabWorkHint" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <!-- 3 秒没自动检测到端口时，把手动输入亮出来（照 Campfire 的 PanPortInput） -->
          <Border x:Name="WorkPortPanel" Style="{StaticResource Card}" Margin="0,15,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="手动输入端口" Style="{StaticResource SectionTitle}" />
              <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="在单人世界里按 Esc 选择「对局域网开放」并创建局域网世界，聊天栏会显示端口号（Local port）。把它填进来，朋友才能连进你的世界。" />
              <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBox x:Name="WorkPortBox" Width="120" MaxLength="5" Style="{StaticResource InputBox}"
                         ToolTip="25565" KeyDown="WorkPort_KeyDown" />
                <Button x:Name="BtnUsePort" Margin="10,0,0,0" Height="32" MinWidth="88"
                        Style="{StaticResource SubtleButton}" Content="确定" Click="UsePort_Click" />
                <Button x:Name="BtnSkipPort" Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource LinkButton}" Content="先跳过，稍后再填" Click="SkipPort_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Button x:Name="BtnWorkCancel" HorizontalAlignment="Right" MinWidth="88"
                  Style="{StaticResource SubtleButton}" Content="取消" Click="WorkCancel_Click" />
        </Grid>
      </Grid>

      <!-- ════════════════ 房主 · 房间已创建（照 Campfire PanHost） ════════════════ -->
      <Grid x:Name="PaneHost" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,2,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabel}" Text="邀请码" />
                    <TextBlock x:Name="LabHostCode" Margin="0,2,0,0" Style="{StaticResource MonoText}"
                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                  <Button x:Name="BtnCopyCode" Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                          FontWeight="Bold" Style="{StaticResource AccentButton}" Content="复制邀请码"
                          Click="CopyCode_Click" />
                </Grid>
                <TextBlock x:Name="LabHostTip" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="请将邀请码发送给其他玩家，并在房间开启期间保持 LMCL 与游戏运行。" />
                <UniformGrid Margin="0,14,0,0" Columns="3">
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="游戏端口" />
                    <TextBlock x:Name="LabHostPort" Style="{StaticResource StatValue}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="连接" />
                    <TextBlock x:Name="LabHostLinks" Style="{StaticResource StatValue}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="本机网络" />
                    <TextBlock x:Name="LabHostNat" Style="{StaticResource StatValue}" />
                  </StackPanel>
                </UniformGrid>
                <!-- 端口没检测到 / 想改：随时手动填（照 Campfire 的手动指定端口） -->
                <StackPanel x:Name="HostPortPanel" Margin="0,12,0,0" Orientation="Horizontal" Visibility="Collapsed">
                  <TextBox x:Name="HostPortBox" Width="120" MaxLength="5" Style="{StaticResource InputBox}"
                           ToolTip="25565" KeyDown="HostPort_KeyDown" />
                  <Button x:Name="BtnSetHostPort" Margin="10,0,0,0" Height="32" MinWidth="88"
                          Style="{StaticResource SubtleButton}" Content="确定" Click="SetHostPort_Click" />
                  <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="朋友在「直接连接」里填 你的虚拟IP:端口 进世界。" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="HintHostNodes" Style="{StaticResource HintCard}" Margin="0,15,0,0"
                    Visibility="Collapsed">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                         Text="共享节点连不上：双方都在内网时可能无法互相发现。可在「联机设置 → 中转节点」里添加或更换节点。" />
            </Border>

            <Border x:Name="CardHostPlayers" Style="{StaticResource Card}" Margin="0,15,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="房间成员" Style="{StaticResource SectionTitle}" />
                <ScrollViewer MaxHeight="116" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl x:Name="HostPlayersList" Focusable="False" ItemTemplate="{StaticResource PlayerTemplate}" />
                </ScrollViewer>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,15,0,0">
              <StackPanel>
                <TextBlock Text="工具" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <Grid Style="{StaticResource ToolRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource ToolIcon}">
                    <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70F;" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="公开到联机大厅" />
                    <TextBlock x:Name="LabRoomSettings" Style="{StaticResource ToolState}" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource SubtleButton}" MinWidth="76" Margin="12,0,0,0"
                          VerticalAlignment="Center" Content="编辑" Click="RoomSettings_Click" />
                </Grid>
                <Grid Style="{StaticResource ToolRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource ToolIcon}">
                    <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9D9;" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="联机诊断" />
                    <TextBlock x:Name="LabHostDiagnostics" Style="{StaticResource ToolState}" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource SubtleButton}" MinWidth="76" Margin="12,0,0,0"
                          VerticalAlignment="Center" Content="打开" Click="OpenDiagnostics_Click" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="DotLobby" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{DynamicResource DividerBrush}" />
            <TextBlock x:Name="LabLobby" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="未公开到联机大厅" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnFavoriteHost" Margin="12,0,0,0" MinWidth="92" Style="{StaticResource SubtleButton}"
                    Click="Favorite_Click" Content="收藏房间" />
            <Button x:Name="BtnLobbyPublish" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                    Style="{StaticResource AccentButton}" Content="公开到联机大厅" Click="LobbyPublish_Click" />
            <Button x:Name="BtnCloseRoom" Margin="12,0,0,0" Style="{StaticResource SubtleButton}"
                    Content="关闭房间" Click="CloseRoom_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ════════════════ 客人 · 已加入（照 Campfire PanGuest） ════════════════ -->
      <Grid x:Name="PaneGuest" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,2,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Border Style="{StaticResource HintCard}">
                  <TextBlock x:Name="LabGuestGuide" TextWrapping="Wrap" FontWeight="Bold"
                             Text="已加入房间。在多人游戏列表底部的局域网世界中进入房间。" />
                </Border>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabel}" Text="房主的虚拟 IP" />
                    <TextBlock x:Name="LabGuestAddress" Margin="0,2,0,0" Style="{StaticResource MonoText}"
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                  <Button x:Name="BtnCopyAddress" Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                          Style="{StaticResource SubtleButton}" Content="复制地址" Click="CopyAddress_Click" />
                </Grid>
                <UniformGrid Margin="0,14,0,0" Columns="3">
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="延迟" />
                    <TextBlock x:Name="LabGuestLatency" Style="{StaticResource StatValue}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="房间人数" />
                    <TextBlock x:Name="LabGuestPath" Style="{StaticResource StatValue}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="本机网络" />
                    <TextBlock x:Name="LabGuestNat" Style="{StaticResource StatValue}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
            <Border x:Name="CardGuestPlayers" Style="{StaticResource Card}" Margin="0,15,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="房间成员" Style="{StaticResource SectionTitle}" />
                <ScrollViewer MaxHeight="116" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl x:Name="GuestPlayersList" Focusable="False" ItemTemplate="{StaticResource PlayerTemplate}" />
                </ScrollViewer>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="离线账号须通过局域网世界列表进入房间。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="BtnFavoriteGuest" MinWidth="92" Style="{StaticResource SubtleButton}"
                    Click="Favorite_Click" Content="收藏房间" />
            <Button x:Name="BtnGuestLeave" Margin="12,0,0,0" Style="{StaticResource SubtleButton}"
                    Content="退出房间" Click="CloseRoom_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ════════════════ 公开到联机大厅（照 Campfire PanPublish） ════════════════ -->
      <Grid x:Name="PanePublish" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock VerticalAlignment="Center" Text="房间名称" />
              <TextBox x:Name="PubTitleBox" Grid.Column="1" Margin="14,0,0,0" MaxLength="24"
                       Style="{StaticResource InputBox}" KeyDown="PublishField_KeyDown" />
              <TextBlock Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top" Padding="0,6,0,0" Text="房间介绍" />
              <TextBox x:Name="PubDescBox" Grid.Row="1" Grid.Column="1" Margin="14,12,0,0" Height="56" MaxLength="100"
                       TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto" Style="{StaticResource InputBox}"
                       ToolTip="选填，说说玩法、规则或欢迎的玩家" />
              <TextBlock Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center" Text="房间密码" />
              <TextBox x:Name="PubPasswordBox" Grid.Row="2" Grid.Column="1" Margin="14,12,0,0" MaxLength="32"
                       Style="{StaticResource InputBox}"
                       ToolTip="选填，留空则任何人都能加入；设置后别人加入时要先填对密码" />
              <CheckBox x:Name="ChkPubRegion" Grid.Row="3" Grid.Column="1" Margin="14,12,0,0"
                        Content="显示所在地区" />
            </Grid>
          </Border>
          <Border Style="{StaticResource HintCard}" Margin="0,15,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="公开后，所有玩家都能在联机大厅看到并加入这个房间。关闭房间时将自动取消公开。" />
          </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SubtleButton}" Content="返回" Click="Back_Click" />
            <Button x:Name="BtnPublishConfirm" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                    Style="{StaticResource AccentButton}" Content="公开房间" Click="PublishConfirm_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ════════════════ 联机大厅（照 Campfire LobbyPage） ════════════════ -->
      <Grid x:Name="PaneLobby" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="LobbySearchBox" Height="32" Style="{StaticResource InputBox}" MaxLength="40"
                   ToolTip="搜索房间名称、房主或地图" TextChanged="LobbySearch_TextChanged" />
          <ComboBox x:Name="LobbyVersionBox" Grid.Column="1" Margin="8,0,0,0" MaxDropDownHeight="300"
                    VerticalContentAlignment="Center" SelectionChanged="LobbyVersion_Changed" />
          <Button x:Name="BtnLobbyRefresh" Grid.Column="2" Margin="8,0,0,0" Height="32" MinWidth="88"
                  Style="{StaticResource SubtleButton}" Content="刷新" Click="LobbyRefresh_Click" />
          <Button x:Name="BtnLobbyCreate" Grid.Column="3" Margin="8,0,0,0" Height="32" MinWidth="104"
                  FontWeight="Bold" Style="{StaticResource AccentButton}" Content="创建房间"
                  Click="LobbyCreate_Click" />
        </Grid>
        <Border x:Name="LobbyNotice" Grid.Row="1" Style="{StaticResource HintCard}" Margin="0,12,0,0"
                Visibility="Collapsed">
          <TextBlock x:Name="LabLobbyNotice" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="LabRoomsHeader" Style="{StaticResource SectionTitle}" Text="公开房间" />
                <ItemsControl x:Name="LobbyRows" Focusable="False" Margin="0,4,0,0" />
                <StackPanel x:Name="PanLobbyState" Margin="0,8,0,2" HorizontalAlignment="Center"
                            Orientation="Horizontal" Visibility="Collapsed">
                  <TextBlock x:Name="LabLobbyState" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button x:Name="BtnLobbyRetry" Margin="12,0,0,0" VerticalAlignment="Center"
                          Style="{StaticResource LinkButton}" Content="重试" Visibility="Collapsed"
                          Click="LobbyRefresh_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ════════════════ 房间详情（照 Campfire LobbyRoomPage） ════════════════ -->
      <Grid x:Name="PaneRoomDetail" Visibility="Hidden">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource RoomIconCircle}" Width="52" Height="52">
                  <TextBlock x:Name="RoomDetailIcon" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RoomDetailLocked" Text="&#xE72E;" FontFamily="{DynamicResource IconFont}"
                               FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="RoomDetailTitle" FontSize="16" FontWeight="SemiBold" Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock x:Name="RoomDetailPills" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
              <UniformGrid Margin="0,18,0,0" Columns="3">
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="房主" />
                  <TextBlock x:Name="RoomDetailHost" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="版本" />
                  <TextBlock x:Name="RoomDetailVersion" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="玩家" />
                  <TextBlock x:Name="RoomDetailPlayers" Style="{StaticResource StatValue}" />
                </StackPanel>
              </UniformGrid>
              <UniformGrid Margin="0,14,0,0" Columns="3">
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="地图" />
                  <TextBlock x:Name="RoomDetailMap" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="地区" />
                  <TextBlock x:Name="RoomDetailPlace" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource StatLabel}" Text="开房时间" />
                  <TextBlock x:Name="RoomDetailOpened" Style="{StaticResource StatValue}" />
                </StackPanel>
              </UniformGrid>
              <TextBlock x:Name="RoomDetailDesc" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <Border x:Name="RoomDetailPasswordCard" Style="{StaticResource Card}" Margin="0,15,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="房间密码" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="RoomDetailPasswordBox" Margin="0,10,0,0" MaxLength="32"
                       Style="{StaticResource InputBox}" ToolTip="房间密码" KeyDown="RoomPassword_KeyDown" />
              <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" Text="房主为这个房间设置了密码。" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SubtleButton}" Content="返回" Click="Back_Click" />
            <Button x:Name="BtnDetailJoin" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                    Style="{StaticResource AccentButton}" Content="加入房间" Click="DetailJoin_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ════════════════ 最近房间（照 Campfire RecentPage） ════════════════ -->
      <ScrollViewer x:Name="PaneRecent" Visibility="Hidden" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="常用房间" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="LabFavCount" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <ItemsControl x:Name="FavRows" Focusable="False" />
          <TextBlock x:Name="LabNoFav" Margin="2,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="还没有常用房间，点击房间右侧的星标即可收藏。" />

          <Grid Margin="2,24,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="最近房间" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="LabRecentCount" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="BtnClearRecent" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                    Style="{StaticResource LinkButton}" Content="清除记录" Click="ClearRecent_Click" />
          </Grid>
          <ItemsControl x:Name="RecentRows" Focusable="False" />
          <TextBlock x:Name="LabNoRecent" Margin="2,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="还没有房间记录。" />
          <TextBlock Margin="2,20,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="加入过的房间只有在房主仍开着时才能再次进入。自己开过的房间会沿用原来的邀请码，已发给朋友的邀请码可以继续使用。" />
        </StackPanel>
      </ScrollViewer>

      <!-- ════════════════ 联机设置（照 Campfire SettingsPage） ════════════════ -->
      <ScrollViewer x:Name="PaneSettings" Visibility="Hidden" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <Border Style="{StaticResource HintCard}">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="更改即时保存，并于下次创建或加入房间时生效。" />
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock Text="房间" Style="{StaticResource SectionTitle}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="玩家名称" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBox x:Name="SetPlayerNameBox" Grid.Column="1" MaxLength="16" Style="{StaticResource InputBox}"
                         ToolTip="创建或加入房间前须设置玩家名称" LostFocus="PlayerName_LostFocus" />
              </Grid>
              <CheckBox x:Name="ChkAutoCopy" Margin="0,14,0,0" Content="创建房间后自动复制邀请码"
                        Checked="RoomFlag_Changed" Unchecked="RoomFlag_Changed" />
              <CheckBox x:Name="ChkShowRegion" Margin="0,10,0,0" Content="公开房间时显示所在地区"
                        Checked="RoomFlag_Changed" Unchecked="RoomFlag_Changed" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock Text="网络" Style="{StaticResource SectionTitle}" />
              <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="联机组件（EasyTier）随首次联机自动下载；创建房间会请求管理员授权来启用虚拟网卡。" />
              <Button Height="32" Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="88"
                      Style="{StaticResource SubtleButton}" Content="联机诊断" Click="OpenDiagnostics_Click" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock Text="中转服务器" Style="{StaticResource SectionTitle}" />
              <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="中转服务器帮助玩家互相发现，并在直连失败时转发数据。联机双方须至少启用一个相同的服务器。" />
              <StackPanel x:Name="PanServers" Margin="0,4,0,0" />

              <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <Button x:Name="BtnTestNodes" Height="32" MinWidth="88" Style="{StaticResource SubtleButton}"
                        Content="测试服务器" Click="TestNodes_Click" />
                <TextBlock x:Name="LabNodesTest" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="自定义节点" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBox x:Name="SetNodesBox" Grid.Column="1" Height="76" MaxLength="2000"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource InputBox}"
                         ToolTip="每行一个，支持 tcp、udp、ws、wss、quic、http、https 等地址"
                         LostFocus="Nodes_LostFocus" />
              </Grid>

              <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="以上服务器均由社区成员无偿提供，谨向各位提供者致以诚挚的谢意。带「限速」标记的节点对转发流量有上限。" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,15,0,0">
            <StackPanel>
              <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
              <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Button Height="32" MinWidth="110" Style="{StaticResource SubtleButton}" Content="打开数据目录"
                        Click="OpenData_Click" />
                <Button Height="32" MinWidth="110" Margin="10,0,0,0" Style="{StaticResource SubtleButton}"
                        Content="打开联机日志" Click="OpenLogs_Click" />
                <Button x:Name="BtnRemoveComponent" Height="32" MinWidth="110" Margin="10,0,0,0"
                        Style="{StaticResource SubtleButton}" Content="移除联机组件" Click="RemoveComponent_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ════════════════ 修复工具（保留原子页） ════════════════ -->
      <mp:RepairToolsView x:Name="PaneRepair" Visibility="Hidden" />
    </Grid>
  </Grid>
</pages:PageBase>
