<pages:PageBase x:Class="LMCL.App.Views.Pages.ResourcesPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <Grid x:Name="PageRoot" Margin="24,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ 标题 ══════════════════════════════════════════ -->
    <Grid Grid.Row="0" x:Name="PageHeader" Margin="0,0,6,14">
      <StackPanel>
        <TextBlock Text="资源管理" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="DirText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <ComboBox x:Name="VersionCombo" Style="{StaticResource Combo}" Width="260"
                  MaxDropDownHeight="320"
                  SelectionChanged="Version_Changed" />
        <Button x:Name="InstanceLink" Style="{StaticResource SubtleButton}" Content="版本设置"
                Margin="8,0,0,0" Click="Instance_Click" />
      </StackPanel>
    </Grid>

    <!-- ══ 分栏 ══════════════════════════════════════════ -->
    <ListBox Grid.Row="1" x:Name="Tabs" Style="{StaticResource TabStrip}" Margin="0,0,0,10"
             SelectionChanged="Tabs_Changed">
      <ListBoxItem Content="模组" />
      <ListBoxItem Content="资源包" />
      <ListBoxItem Content="光影包" />
      <ListBoxItem Content="存档" />
    </ListBox>

    <!-- ══ 操作条 ══════════════════════════════════════ -->
    <Border Grid.Row="2" Style="{StaticResource CardTight}" Padding="12,10" Margin="0,0,6,12">
      <Grid>
        <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SubtleButton}" Content="导入文件" Click="Import_Click" />
          <Button Style="{StaticResource SubtleButton}" Content="打开文件夹" Margin="8,0,0,0"
                  Click="OpenFolder_Click" />
          <Button Style="{StaticResource SubtleButton}" Content="刷新" Margin="8,0,0,0"
                  Click="Refresh_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ 列表 ════════════════════════════════════════ -->
    <Grid Grid.Row="3">
      <ListBox x:Name="List" Style="{StaticResource PlainList}" Margin="0,0,4,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="已禁用" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Visibility="{Binding DisabledHintVisibility}" />
                <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                          IsChecked="{Binding Enabled, Mode=OneWay}"
                          Visibility="{Binding ToggleVisibility}"
                          Click="Toggle_Click" />
                <Button Style="{StaticResource SubtleButton}" Content="删除" Margin="14,0,0,0"
                        Click="Delete_Click" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyHint" Style="{StaticResource EmptyState}" Visibility="Collapsed"
                 VerticalAlignment="Top" />
    </Grid>
  </Grid>
</pages:PageBase>
