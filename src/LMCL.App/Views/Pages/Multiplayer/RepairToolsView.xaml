<pages:PageBase x:Class="LMCL.App.Views.Pages.Multiplayer.RepairToolsView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,20,18">
    <StackPanel>

      <!-- ══ 联机组件 ══ -->
      <Border Style="{StaticResource Card}" Margin="0,2,0,0">
        <StackPanel>
          <TextBlock Text="联机组件" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="EasyTierState" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />

          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="BtnReinstall" Style="{StaticResource SubtleButton}" Content="重新下载联机组件"
                    Click="Reinstall_Click"
                    ToolTip="把 EasyTier 整个删掉重下：装坏了、版本太旧、网卡驱动缺 DLL 都可以用这一招" />
            <Button x:Name="BtnOpenEasyTierDir" Style="{StaticResource SubtleButton}" Content="打开组件目录"
                    Margin="8,0,0,0" Click="OpenEasyTierDir_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ══ 网络检测 ══ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="网络检测" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="逐个探测启动器会用到的服务，联机大厅刷不出来、下载不动时先来这里看一眼。" />

          <Button x:Name="BtnCheckNet" Style="{StaticResource AccentButton}" Content="开始检测"
                  Margin="0,12,0,0" HorizontalAlignment="Left" Click="CheckNet_Click" />

          <ListBox x:Name="NetList" Style="{StaticResource PlainList}" Margin="0,10,0,0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="188"
                   Focusable="False" IsHitTestVisible="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" FontSize="13"
                             VerticalAlignment="Center" Foreground="{Binding Brush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="8,0,0,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding ResultLabel}" FontSize="12" Margin="12,0,0,0"
                             VerticalAlignment="Center" Foreground="{Binding Brush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- ══ 缓存与诊断 ══ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="缓存与诊断" Style="{StaticResource SectionTitle}" />

          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="BtnClearCache" Style="{StaticResource SubtleButton}" Content="清理地图下载缓存"
                    Click="ClearCache_Click" />
            <Button x:Name="BtnOpenLogs" Style="{StaticResource SubtleButton}" Content="打开日志目录"
                    Margin="8,0,0,0" Click="OpenLogs_Click" />
            <Button x:Name="BtnOpenConfig" Style="{StaticResource SubtleButton}" Content="打开配置文件夹"
                    Margin="8,0,0,0" Click="OpenConfig_Click" />
          </WrapPanel>

          <TextBlock x:Name="RepairStatus" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:PageBase>
