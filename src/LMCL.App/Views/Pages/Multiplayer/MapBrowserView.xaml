<pages:PageBase x:Class="LMCL.App.Views.Pages.Multiplayer.MapBrowserView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,20,18">
    <StackPanel>

      <!-- ══ 在线搜索 ══ -->
      <Border Style="{StaticResource Card}" Margin="0,2,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="在线地图（CurseForge）" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <Button x:Name="BtnSearch" Grid.Column="1" Style="{StaticResource SubtleButton}"
                    Content="搜索" Click="Search_Click" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.6*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="关键字" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="QueryBox" Style="{StaticResource InputBox}" KeyDown="QueryBox_KeyDown" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="游戏版本（留空不限）" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="VersionBox" Style="{StaticResource InputBox}"
                       ToolTip="例如 1.21.4" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="SortBox" VerticalContentAlignment="Center">
                <ComboBoxItem Content="最受欢迎" IsSelected="True" />
                <ComboBoxItem Content="下载最多" />
                <ComboBoxItem Content="最近更新" />
                <ComboBoxItem Content="最新发布" />
                <ComboBoxItem Content="按名称" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="每页" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="PageSizeBox" VerticalContentAlignment="Center" Width="86"
                        SelectionChanged="PageSize_SelectionChanged"
                        ToolTip="列表每页显示多少个地图">
                <ComboBoxItem Content="20 个" IsSelected="True" />
                <ComboBoxItem Content="40 个" />
                <ComboBoxItem Content="60 个" />
                <ComboBoxItem Content="100 个" />
              </ComboBox>
            </StackPanel>
          </Grid>

          <!-- 平行视界：左边浏览列表，右边详情；点左边一条，右边出简介和文件 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="1.15*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：浏览列表 -->
            <StackPanel>
              <ListBox x:Name="MapList" Style="{StaticResource PlainList}"
                       MaxHeight="430" ScrollViewer.VerticalScrollBarVisibility="Auto"
                       SelectionMode="Single" SelectionChanged="MapList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 行内头图缩略：服务没给图就放一个地图图标占位 -->
                  <Border Width="46" Height="46" CornerRadius="6" VerticalAlignment="Top"
                          Background="{DynamicResource DividerBrush}">
                    <Grid>
                      <Image x:Name="Thumb" Source="{Binding LogoImage}" Stretch="UniformToFill"
                             Visibility="{Binding HasLogo, Converter={StaticResource BoolVisible}}" />
                      <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolVisible}}" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding AuthorLabel}" FontSize="12" Margin="10,0,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DetailLabel}" FontSize="11.5" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="MapStatus" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />

          <!-- 分页条 -->
          <StackPanel x:Name="PagerPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <Button x:Name="BtnPrevPage" Style="{StaticResource SubtleButton}" Content="上一页"
                    Click="PrevPage_Click" />
            <TextBlock x:Name="PageLabel" Style="{StaticResource CaptionText}" Margin="12,0,12,0"
                       VerticalAlignment="Center" />
            <Button x:Name="BtnNextPage" Style="{StaticResource SubtleButton}" Content="下一页"
                    Click="NextPage_Click" />
          </StackPanel>
            </StackPanel>

            <!-- 右：详情栏 -->
            <Grid Grid.Column="2">
              <!-- 还没选地图时的占位 -->
              <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                           HorizontalAlignment="Center" Foreground="{DynamicResource DividerBrush}" />
                <TextBlock Text="从左边选一个地图" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="简介、版本和可下载的文件会显示在这里" FontSize="11.5" Margin="0,3,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>

              <!-- 详情：头图 + 简介 + 文件列表；选中一条搜索结果才出现 -->
              <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <!-- 头部：左图右文（WinUI 列表详情头版式） -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="LogoBorder" Width="88" Height="88" CornerRadius="8"
                          Background="{DynamicResource CardBrush}" Visibility="Collapsed">
                    <Image x:Name="LogoImage" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button x:Name="BtnOpenWebsite" Style="{StaticResource LinkButton}" Content="在 CurseForge 打开"
                              Visibility="Collapsed" Click="OpenWebsite_Click"
                              ToolTip="用默认浏览器打开这个地图的发布页" />
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <!-- 简介全文：过长内部滚动 -->
                <ScrollViewer MaxHeight="150" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto" Focusable="False">
                  <TextBlock x:Name="DetailDesc" Style="{StaticResource CaptionText}"
                             LineHeight="19" TextWrapping="Wrap" />
                </ScrollViewer>

                <TextBlock Text="可下载文件" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                <ListBox x:Name="FileList" Style="{StaticResource PlainList}" MaxHeight="200"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                          <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextBrush}" />
                          <TextBlock Text="{Binding DetailLabel}" FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                                Content="{Binding ActionLabel}"
                                VerticalAlignment="Center" Margin="10,0,0,0"
                                ToolTip="{Binding ActionTip}"
                                Click="Download_Click" Tag="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="DownloadPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="DownloadText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                  <Button x:Name="BtnGotoImported" Style="{StaticResource SubtleButton}" Content="导入到存档…"
                          Margin="12,0,0,0" Click="ImportDownloaded_Click" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:PageBase>
