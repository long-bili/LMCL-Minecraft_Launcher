<pages:PageBase x:Class="LMCL.App.Views.Pages.DownloadPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:pages="clr-namespace:LMCL.App.Views.Pages"
               xmlns:controls="clr-namespace:LMCL.App.Controls"
               FontFamily="{DynamicResource AppFont}" FontSize="13.5"
               Foreground="{DynamicResource TextBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="176" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ══════════════════════════════════════════════════════════
         左：分区导航

         游戏版本 / 模组 / 资源包 / 数据包 / 光影 是「找得到什么」这一类，
         整合包是「装一整套」——性质不同，所以拆成上下两组，整合包钉在底部。?
         ══════════════════════════════════════════════════════════ -->
    <Border Grid.Column="0" Background="{DynamicResource LayerBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
            Padding="12,20,8,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="SectionList" Grid.Row="0" VerticalAlignment="Top"
                 Style="{StaticResource SideNav}"
                 SelectionChanged="SectionList_SelectionChanged">
          <ListBoxItem Tag="minecraft">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE967;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="游戏版本" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="mod">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74C;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="模组" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="resourcepack">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="资源包" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="datapack">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE943;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="数据包" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="shaderpack">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE706;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="光影" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>

        <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="4,0,4,10" />

        <ListBox x:Name="ModpackSectionList" Grid.Row="1" Style="{StaticResource SideNav}"
                 SelectionChanged="ModpackSectionList_SelectionChanged">
          <ListBoxItem Tag="modpack">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                         Width="24" VerticalAlignment="Center" />
              <TextBlock Text="整合包" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Grid>
    </Border>

    <!-- 右侧内容区：三个分区面板叠在同一格里，靠可见性 + 位移动画切换 -->
    <Grid Grid.Column="1">

      <!-- ══════════════════════════════════════════════════════════
           分区一：游戏版本（原版 + 加载器）
           左边一列版本清单，点一下弹出安装对话框选加载器。?
           ══════════════════════════════════════════════════════════ -->
      <Grid x:Name="PaneMinecraft" Margin="26,22,26,20">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="PaneMinecraftOffset" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：类型筛选 + 关键字 + 刷新清单 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Width="148" Margin="0,0,12,0">
            <TextBlock Text="版本类型" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeCombo" Style="{StaticResource Combo}"
                      SelectionChanged="Type_Changed" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="搜索版本" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="VersionFilter" Style="{StaticResource InputBox}"
                     ToolTip="按版本号筛选，比如 1.20"
                     TextChanged="VersionFilter_Changed" />
          </StackPanel>

          <Button Grid.Column="2" x:Name="BtnReloadVersions" Style="{StaticResource SubtleButton}"
                  Content="刷新清单" VerticalAlignment="Bottom" Margin="0,0,0,1"
                  Click="Reload_Click" />
        </Grid>

        <!-- 版本清单 + 加载器 + 空状态 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
          <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                   FocusVisualStyle="{x:Null}"
                   ItemContainerStyle="{StaticResource RowCompact}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="GameList_Click">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}" />
                  <Border Grid.Column="1" Padding="7,2" CornerRadius="4" VerticalAlignment="Center"
                          Background="{DynamicResource SubtleHoverBrush}">
                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <controls:MarqueeBar x:Name="VersionMarquee" Width="180" Height="4"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="Collapsed" />

          <TextBlock x:Name="VersionEmpty" Style="{StaticResource EmptyState}"
                     TextAlignment="Center" MaxWidth="420" Visibility="Collapsed" />
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════
           分区二：社区资源（模组 / 资源包 / 数据包 / 光影 共用）
           上面是搜索条件，中间是结果列表，点一条进去看版本详情。?
           五个分区共用这一块，只是「类型」「安装到哪个目录」跟着换。?
           ══════════════════════════════════════════════════════════ -->
      <Grid x:Name="PaneCatalog" Margin="26,22,26,20"
            Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="PaneCatalogOffset" />
        </Grid.RenderTransform>

        <!-- ── 浏览态 ───────────────────────────────────────
             行：搜索栏 / 筛选栏 / 结果列表(*) / 更新面板 / 翻页。
             列表单独占一个 * 行，翻页和更新面板在它下面各占一个 Auto 行，
             这样列表自己就能撑满剩余高度并正常滚动 —— 早先把筛选、列表、
             翻页塞进同一个格子，列表拿不到确定高度，滚不动也翻不了页。-->
        <Grid x:Name="CatalogBrowse">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 第一行：关键字 + 搜索 / 检查更新 / 重置 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="关键字" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="ModQuery" Style="{StaticResource InputBox}"
                       ToolTip="搜索 Modrinth 上的内容，留空则按热度列出"
                       KeyDown="ModQuery_KeyDown" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                    Content="搜索" MinWidth="88" VerticalAlignment="Bottom"
                    Margin="0,0,8,1" Click="ModSearchButton_Click" />
            <Button Grid.Column="2" x:Name="BtnCheckModUpdates"
                    Style="{StaticResource SubtleButton}"
                    Content="检查更新" MinWidth="96" VerticalAlignment="Bottom"
                    ToolTip="比对已装模组的哈希，看有没有新版本"
                    Margin="0,0,8,1" Click="CheckModUpdates_Click" />
            <Button Grid.Column="3" Style="{StaticResource SubtleButton}"
                    Content="重置" MinWidth="72" VerticalAlignment="Bottom"
                    Margin="0,0,0,1" Click="ModResetButton_Click" />
          </Grid>

          <!-- 第二行：安装到 / 游戏版本 / 加载器 / 分类 / 状态 -->
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <!--
              列宽一律用 Auto + 固定宽度给到内容本身，不要写死在 ColumnDefinition 上：
              光影分区会把「安装到 / 游戏版本 / 加载器」三块收起来，写死的列宽
              不会跟着收，中间会空出一大片，分类下拉被推到很右边。
            -->
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" x:Name="ModTargetHost" Width="230" Margin="0,0,12,0">
              <TextBlock Text="安装到" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ModTargetCombo" Style="{StaticResource Combo}"
                        ToolTip="装进哪个实例；模组要有对应的加载器才能用"
                        SelectionChanged="ModTarget_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="1" x:Name="ModVersionHost" Width="150" Margin="0,0,12,0">
              <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ModGameVersionCombo" Style="{StaticResource Combo}"
                        SelectionChanged="ModFilter_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="2" x:Name="ModLoaderHost" Width="130" Margin="0,0,12,0">
              <TextBlock Text="加载器" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ModLoaderCombo" Style="{StaticResource Combo}"
                        SelectionChanged="ModFilter_Changed" />
            </StackPanel>

            <!-- 分类：数据包在 Modrinth 上没有分类，那种情况下整块收起 -->
            <StackPanel Grid.Column="3" x:Name="ModTagHost" Width="150">
              <TextBlock x:Name="ModTagLabel" Text="分类" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ModTagCombo" Style="{StaticResource Combo}"
                        MaxDropDownHeight="320"
                        ToolTip="按内容分类筛选，如「性能优化」「科技」"
                        SelectionChanged="ModFilter_Changed" />
            </StackPanel>

            <TextBlock Grid.Column="4" x:Name="ModStatusInline"
                       Style="{StaticResource CaptionText}" VerticalAlignment="Bottom"
                       TextAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,6" />
          </Grid>

          <!-- 第三行：结果列表 + 加载中 + 空态（这一格是 *，列表在这里滚动）-->
          <Grid Grid.Row="2" Margin="0,12,0,0">
              <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                       FocusVisualStyle="{x:Null}"
                       ItemContainerStyle="{StaticResource RowResult}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       MouseLeftButtonUp="ModList_Click">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Width="48" Height="48" CornerRadius="6" VerticalAlignment="Top"
                              Background="{DynamicResource SubtleHoverBrush}">
                        <Image Stretch="UniformToFill" Margin="1"
                               Source="{Binding Icon}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding VersionsText}" FontSize="11"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding LoadersText}" FontSize="11"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                        <Border Padding="7,2" CornerRadius="4"
                                Background="{DynamicResource SubtleHoverBrush}">
                          <TextBlock Text="{Binding SourceText}" FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding DownloadsText}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                        <TextBlock Text="安装" FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <controls:MarqueeBar x:Name="ModMarquee" Width="180" Height="4"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed" />

              <TextBlock x:Name="ModEmpty" Style="{StaticResource EmptyState}"
                         TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                         HorizontalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <!-- 更新结果：检查完更新后才出现，列出「当前 → 新版」并给一键更新 -->
            <Border Grid.Row="3" x:Name="ModUpdatePanel" Style="{StaticResource CardTight}"
                    Margin="0,12,0,0" Padding="12,10" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ModUpdateTitle" Style="{StaticResource SecondaryText}"
                             VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="1" x:Name="BtnUpdateAllMods"
                          Style="{StaticResource AccentButton}" Content="全部更新"
                          MinWidth="96" Margin="8,0,0,0" Click="UpdateAllMods_Click" />
                  <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Content="关闭"
                          MinWidth="72" Margin="8,0,0,0" Click="CloseModUpdates_Click" />
                </Grid>

                <ItemsControl x:Name="ModUpdateList" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- 翻页：始终占一行，靠可见性显隐 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,12,0,0" x:Name="ModPager" Visibility="Collapsed">
              <Button Style="{StaticResource SubtleButton}" Content="上一页"
                      MinWidth="96" Click="ModPrevPage_Click" />
              <TextBlock x:Name="ModPageLabel" Style="{StaticResource SecondaryText}"
                         VerticalAlignment="Center" Margin="12,0" />
              <Button Style="{StaticResource SubtleButton}" Content="下一页"
                      MinWidth="96" Click="ModNextPage_Click" />
            </StackPanel>

            <!--
              结果条数：放在**翻页下面**单独一行。
              之前塞在结果列表里（ModEmpty，盖在列表上），
              正好压在第一条结果上，看着像串行了。
            -->
            <TextBlock Grid.Row="5" x:Name="ModCountText" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="Collapsed" />
          </Grid>

        <!-- ── 详情态：点中一条之后看版本、更新日志，直接装 ── -->
        <Grid x:Name="CatalogDetail" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Button Style="{StaticResource SubtleButton}"
                  HorizontalAlignment="Left" Padding="10,6" Click="ModDetailBack_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                         VerticalAlignment="Center" />
              <TextBlock Text="返回列表" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,4,0"
                        Margin="0,14,0,0">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ModTitle" Text="没选中" FontSize="20" FontWeight="SemiBold"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Style="{StaticResource Chip}">
                      <TextBlock x:Name="ModAuthor" Text="—" Style="{StaticResource ChipText}" />
                    </Border>
                    <TextBlock x:Name="ModMeta" Style="{StaticResource CaptionText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>

                  <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                  <TextBlock x:Name="ModDescription" Style="{StaticResource SecondaryText}"
                             Text="没有简介。" TextWrapping="Wrap" />

                  <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="ModVersionList" Style="{StaticResource Combo}"
                              MaxWidth="460" HorizontalAlignment="Left"
                              MaxDropDownHeight="320" SelectionChanged="ModVersion_Changed" />
                  </Grid>
                  <TextBlock x:Name="ModVersionHint" Style="{StaticResource CaptionText}"
                             Margin="0,10,0,0" TextWrapping="Wrap" />

                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="BtnInstallMod" Style="{StaticResource AccentButton}"
                            MinWidth="140" Content="安装" IsEnabled="False"
                            Click="InstallMod_Click" />
                    <Button Style="{StaticResource SubtleButton}" Content="在浏览器打开"
                            Margin="8,0,0,0" Click="OpenModPage_Click" />
                  </StackPanel>
                  <TextBlock x:Name="ModNote" Style="{StaticResource CaptionText}"
                             Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="更新日志" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="ModChangelog" Style="{StaticResource SecondaryText}"
                             Margin="0,10,0,0" TextWrapping="Wrap"
                             Text="选中一个版本后，这里显示它的更新日志。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════
           分区三：整合包（Modrinth）?
           搜索 + 本地 .mrpack 导入，装上就是一个独立实例。?
           ══════════════════════════════════════════════════════════ -->
      <Grid x:Name="PaneModpack" Margin="26,22,26,20"
            Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="PaneModpackOffset" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Padding="12,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="PackQuery" Style="{StaticResource InputBox}"
                     MaxWidth="360" HorizontalAlignment="Left" Width="360"
                     ToolTip="搜索 Modrinth 上的整合包，留空则按热度列出"
                     KeyDown="PackQuery_KeyDown" />

            <TextBlock Grid.Column="1" Text="游戏版本" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" Margin="14,0,8,0" />
            <ComboBox Grid.Column="2" x:Name="PackVersionCombo" Style="{StaticResource Combo}"
                      Width="128" MaxDropDownHeight="300" />

            <TextBlock Grid.Column="3" Text="加载器" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" Margin="14,0,8,0" />
            <ComboBox Grid.Column="4" x:Name="PackLoaderCombo" Style="{StaticResource Combo}"
                      Width="140" MaxDropDownHeight="280"
                      SelectionChanged="PackFilter_Changed" />

            <TextBlock Grid.Column="5" Text="分类" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" Margin="14,0,8,0" />
            <ComboBox Grid.Column="6" x:Name="PackTagCombo" Style="{StaticResource Combo}"
                      Width="140" MaxDropDownHeight="320"
                      ToolTip="按内容分类筛选，如「科技」「空岛」"
                      SelectionChanged="PackFilter_Changed" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="0,0,12,4">
            <ListBox x:Name="PackList" Background="Transparent" BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource RowResult}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Pack_Changed">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="PackEmpty" Style="{StaticResource EmptyState}"
                       VerticalAlignment="Top" Visibility="Collapsed"
                       Text="点右边的「搜索」或者直接敲回车开始搜整合包。" />
          </Grid>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="PackTitle" Text="没选中整合包" FontSize="20"
                             FontWeight="SemiBold" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextBrush}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Style="{StaticResource Chip}">
                      <TextBlock x:Name="PackAuthor" Text="—" Style="{StaticResource ChipText}" />
                    </Border>
                    <TextBlock x:Name="PackMeta" Style="{StaticResource CaptionText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>

                  <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                  <TextBlock x:Name="PackDescription" Style="{StaticResource SecondaryText}"
                             Text="左边的列表里挑一个看看。" TextWrapping="Wrap" />

                  <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnInstallPack" Style="{StaticResource AccentButton}"
                            MinWidth="150" Content="下载并安装" IsEnabled="False"
                            Click="InstallPack_Click" />
                    <Button Style="{StaticResource SubtleButton}" Content="导入本地包"
                            Margin="8,0,0,0" Click="ImportPack_Click" />
                    <Button Style="{StaticResource SubtleButton}" Content="在浏览器打开"
                            Margin="8,0,0,0" Click="OpenPackPage_Click" />
                  </StackPanel>
                  <TextBlock x:Name="PackNote" Style="{StaticResource CaptionText}"
                             Margin="0,10,0,0"
                             Text="装好之后会自动创建同名版本，对应的加载器会一起装好。" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="整合包是怎么装的" Style="{StaticResource SectionTitle}" />
                  <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                             Text="· 先读 .mrpack 里的 modrinth.index.json，知道它要哪个游戏版本和加载器。" />
                  <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                             Text="· 把加载器装成和整合包同名的版本，再把包里的 mods、config 解进去——这样每个整合包都是独立的实例。" />
                  <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                             Text="· 包内文件逐个下载，个别文件失败只会记一条警告、跳过它，不会整个装不下去。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

    </Grid>
  </Grid>
</pages:PageBase>
